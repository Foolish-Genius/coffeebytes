# Copy to .env (gitignored) and paste your keys after the = sign. Leave blank to run free/deterministic.
# Claude API key: enables the optional, cost-capped LLM fallback (console.anthropic.com -> API keys)
ANTHROPIC_API_KEY=
# Crustdata API key: company context (domain owner, HQ, headcount) for identity + trader signal (optional)
CRUSTDATA_API_KEY=
# Mouser API key: live authorized-distributor stock/price for the component lane (optional)
MOUSER_API_KEY=
