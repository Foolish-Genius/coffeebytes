# Copy to .env (gitignored) and paste your keys after the = sign. Leave blank to run free/deterministic.
# Claude API key: enables the optional, cost-capped LLM fallback (console.anthropic.com -> API keys)
ANTHROPIC_API_KEY=
# Crustdata API key: company context (domain owner, HQ, headcount) for identity + trader signal (optional)
CRUSTDATA_API_KEY=
# Mouser API key: live authorized-distributor stock/price for the component lane (optional)
MOUSER_API_KEY=
# --- Web app (api/ + web/) ---
# Stripe TEST MODE ONLY: the server refuses sk_live_ keys. Dashboard -> Developers -> API keys (toggle "Test mode").
STRIPE_SECRET_KEY=
# Webhook signing secret: from `stripe listen --forward-to localhost:8000/api/stripe/webhook`, or the test-mode dashboard webhook
STRIPE_WEBHOOK_SECRET=
# Where the app is reachable (used for Stripe return URLs and Google OAuth redirect)
PUBLIC_BASE_URL=http://localhost:8000
# Google sign-in (optional; button hidden when blank). OAuth client redirect URI: <PUBLIC_BASE_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Admin Google account(s), comma-separated. Admins sign in with Google only, never pay for jobs, and get the Admin page.
ADMIN_EMAILS=
# Set to 1 to let web jobs spend Crustdata credits (default: dry-run plan only, no spend)
SS_WEB_CRUSTDATA_SPEND=

# Free starter credits for each new web account (jobs run without Stripe)
SS_WEB_FREE_CREDITS=10
