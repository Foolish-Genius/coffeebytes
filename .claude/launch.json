{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "workbench",
      "runtimeExecutable": "py",
      "runtimeArgs": [
        "-3.13",
        "-m",
        "streamlit",
        "run",
        "app.py",
        "--server.port",
        "8501",
        "--server.headless",
        "true",
        "--browser.gatherUsageStats",
        "false"
      ],
      "port": 8501
    },
    {
      "name": "web",
      "runtimeExecutable": "py",
      "runtimeArgs": [
        "-3.13",
        "-m",
        "uvicorn",
        "api.main:create_app",
        "--factory",
        "--port",
        "8000"
      ],
      "port": 8000
    }
  ]
}
